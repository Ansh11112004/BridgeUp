# MongoDB connection string (Atlas or self-hosted). Example:
# mongodb+srv://<user>:<password>@cluster0.mongodb.net/bizeventbridge?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://anshkohli20041981_db_user:ljs5CX1eX0HXt9q2@cluster0.hrbq8dy.mongodb.net

# Long random string used to sign JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=hello baby

# How long login tokens stay valid
JWT_EXPIRES_IN=7d

# Port the API listens on (Railway sets this automatically in production)
PORT=5000

# Comma-separated list of allowed frontend origins for CORS
CLIENT_ORIGINS=http://localhost:8080,http://localhost:5173

NODE_ENV=development

